<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  
  <appSettings>
    <add key="effyDocApiBaseUrl" value="https://29429f14-70dc-41c8-bef0-98a176108ced.preview.emergentagent.com/api" />
    <add key="effyDocWebsiteUrl" value="https://29429f14-70dc-41c8-bef0-98a176108ced.preview.emergentagent.com" />
    <add key="EnableLogging" value="true" />
    <add key="LogLevel" value="Info" />
  </appSettings>
  
  <system.net>
    <settings>
      <httpWebRequest useUnsafeHeaderParsing="true" />
    </settings>
    <defaultProxy useDefaultCredentials="true" />
  </system.net>
  
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>