{
  "manifest_version": 3,
  "name": "effyDOC Document Tracker",
  "version": "1.0.0",
  "description": "Track document engagement in real-time directly from Outlook Web. Send trackable documents and see when recipients open, click, and read them.",
  
  "permissions": [
    "activeTab",
    "storage",
    "background",
    "scripting"
  ],
  
  "host_permissions": [
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://54f44f8f-6cf4-4842-bf49-6bd490d293fd.preview.emergentagent.com/*"
  ],
  
  "background": {
    "service_worker": "src/background/background.js"
  },
  
  "content_scripts": [
    {
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*", 
        "https://outlook.office365.com/*"
      ],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_end"
    }
  ],
  
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "effyDOC Document Tracker",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "src/components/*",
        "assets/*"
      ],
      "matches": [
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ]
    }
  ]
}