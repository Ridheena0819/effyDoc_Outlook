<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!-- Backend URL for effyDOC API -->
        <add key="BackendUrl" value="https://f70e6bf0-40a7-454d-8960-1649b6f10c4c.preview.emergentagent.com" />
        
        <!-- WebSocket URL for real-time tracking -->
        <add key="WebSocketUrl" value="wss://f70e6bf0-40a7-454d-8960-1649b6f10c4c.preview.emergentagent.com/api/outlook/ws" />
        
        <!-- Authentication settings -->
        <add key="AutoLogin" value="false" />
        <add key="RememberCredentials" value="true" />
        
        <!-- UI settings -->
        <add key="TaskPaneWidth" value="350" />
        <add key="ShowWelcomeMessage" value="true" />
        
        <!-- Tracking settings -->
        <add key="EnableRealTimeTracking" value="true" />
        <add key="HeartbeatInterval" value="30000" />
        
        <!-- Debug settings -->
        <add key="DebugMode" value="false" />
        <add key="LogLevel" value="Info" />
    </appSettings>
</configuration>